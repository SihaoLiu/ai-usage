[Unit]
Description=AI Usage sync server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ai-usage
Group=ai-usage
WorkingDirectory=/var/lib/ai-usage
ExecStart=/var/lib/ai-usage/bin/ai-usage-server /etc/ai-usage-server/config.yaml
Restart=always
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ai-usage
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
